{
  "name": "msrbot-io",
  "version": "2.0.0",
  "description": "MSRBot.io — Automated cross-publisher media standards registry",
  "scripts": {
    "audit": "node src/main/scripts/audit.documents.js",
    "normalize-url": "node src/main/scripts/url.normalize.js --apply",
    "validate-url": "node src/main/scripts/url.validate.js",
    "extract": "node src/main/scripts/extractDocs.js --provider smpte",
    "extract-ietf": "node src/main/scripts/extractDocs.js --provider ietf",
    "extract-smpte": "node src/main/scripts/extractDocs.js --provider smpte",
    "review-refs": "node src/main/scripts/utils/review.refs.js",
    "keywords-sync": "node src/main/scripts/utils/keywords.sync.js",
    "config-sort": "node src/main/scripts/utils/configSort.js",
    "new-doc": "node src/main/scripts/new-doc.js",
    "test": "node src/main/scripts/test/registry.test.js && node src/main/scripts/test/referencing.flush.test.js",
    "docs-validate": "npm run validate",
    "canonicalize": "node src/main/scripts/canonicalize.js",
    "validate": "node src/main/scripts/validate.js",
    "assemble": "node src/main/scripts/build.assemble-registry.js",
    "build": "node src/main/scripts/build.js",
    "build-index": "node src/main/scripts/build.search-index.js",
    "build-stats": "node src/main/scripts/utils/buildStats.js",
    "build-msi": "node src/main/scripts/buildMasterSuiteIndex.js --out src/main/reports/masterSuiteIndex.json",
    "build-mri": "node src/main/scripts/buildMasterReferenceIndex.js",
    "resolve-orphans": "node src/main/scripts/extras/resolveOrphans.js",
    "validate-mri-coverage": "node src/main/scripts/extras/validateMriCoverage.js",
    "seed-backfill-ietf": "node src/main/scripts/utils/seedBackfill.ietf.js",
    "local-server": "npx http-server build --no-cache"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PrZ3r/MSRBot.io.git"
  },
  "author": "Steve LLamb",
  "license": "CC-BY-4.0",
  "devDependencies": {
    "ajv": "^6.12.6",
    "handlebars": "^4.7.9"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "bootstrap-icons": "^1.9.1",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.20",
    "json-source-map": "^0.6.1",
    "json-stable-stringify": "^1.0.1",
    "minisearch": "^7.2.0",
    "node": "^24.14.1",
    "yargs": "^18.0.0"
  }
}
