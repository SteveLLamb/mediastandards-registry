

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://msrbot.io/schemas/portals.schema.json",
  "title": "MSRBot Portals",
  "type": "object",
  "additionalProperties": false,
  "required": ["portals"],
  "properties": {
    "portals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/portal" }
    }
  },
  "definitions": {
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portalSlug", "portalTitle", "summary", "items"],
      "properties": {
        "portalSlug": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "portalTitle": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/definitions/portalSection" }
        },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/definitions/resource" }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/portalItem" }
        },
        "filter": {
          "type": "array",
          "items": { "$ref": "#/definitions/portalItem" }
        }
      }
    },
    "portalSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "href"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "format": "uri" },
        "description": { "type": "string" }
      }
    },
    "portalItem": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["docId"],
          "properties": {
            "docId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["match"],
          "properties": {
            "match": { "$ref": "#/definitions/matchRule" },
            "latestOnly": { "type": "boolean" }
          }
        }
      ]
    },
    "matchRule": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "publisher": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "array",
              "minItems": 1,
              "items":
               { "type": "string", "minLength": 1 }
            }
          ]
        },
        "suiteTitle": { "type": "string", "minLength": 1 },
        "keyword": { "type": "string", "minLength": 1 }
      }
    }
  }
}