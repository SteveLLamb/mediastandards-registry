    "authors": [
      {
        "affiliation": "3M, 3M Center St. Paul, MN 55144",
        "bio": "Arthur R. Moore is a Senior O.E.M. Specialist at the 3M Center in St. Paul, Minnesota, USA. He received his Bachelor of Science degree in Electrical Engineering from the University of Wisconsin and has been with 3M for 24 years. The last 17 years have been spent in the video tape area and working with the video recorder manufacturers.",
        "name": "A. R. Moore"
      },
      {
        "affiliation": "3M, 3M Center St. Paul, MN 55144",
        "bio": "Michael P. Sharrock was born in Columbus, MS on January 25, 1945. He received the B.A. degree in physics from the College of St. Thomas, St. Paul, MN in 1967 and the M.S. and Ph.D. degrees in physics from the University of Illinois, Urbana, in 1969 and 1973, respectively. His doctoral thesis was on Mossbauer spectroscopy of enzyme iron centers. From 1973 to 1977 he was a Research Fellow in the Department of Biochemistry and Biophysics at the University of Pennsylvania, Philadelphia. From 1977 to 1979 he was an Assistant Professor in the Physics Department of Gustavus Adolphus College, St. Peter, MN Since 1979 he has been with the 3M Company in St. Paul, working in the area of magnetic recording materials.",
        "name": "M. P. Sharrock"
      }
    ],
