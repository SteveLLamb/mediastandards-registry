    "authors": [
      {
        "affiliation": "University of Michigan Media Resources Center Ann Arbor, Michigan",
        "bio": "Frederick M. Remley is SMPTE Governor, Central Region, and Chairman of the SMPTE Board of Editors. He has been active in SMPTE standards work since the early 1960s. He was a member and past chairman of Video Tape Recording Committee (1966–1970), Standards Committee (1970–1974), New Technology Committee (1972–1976), Chairman, Subcommittee 60B, Video Recording, International Electrotechnical Commission Technical Committee 60—Recording. SMPTE Vice-President, Television Affairs, 1979–1982. Associate member, EBU Sub-group G-2, Television Recording, representing Public Broadcasting Service Engineering Committee. At the University of Michigan, he is manager of television and audio-visual production/distribution unit and technical director for three university-owned FM stations and one television station.",
        "name": "Frederick M. Remley"
      }
    ],
