{
  "$schema": "http://json-schema.org/schema#",
  "$id": "https://github.com/PrZ3r/MSRBot.io/documents/2.4.0",
  "$comment": "Copyright (c) 2025-26 PrZ3 LLC (d/b/a [PrZ3](https://github.com/PrZ3r))",
  "docTitle": "Schema for MSRBot.io - Documents",
  "items": {
    "anyOf": [
      {
        "$id": "#/items/anyOf/0",
        "type": "object",
        "required": [
          "docId",
          "docLabel",
          "docTitle",
          "docType",
          "publisher",
          "status"
        ],
        "additionalProperties": true,
        "properties": {
          "authors": {
            "type": "array",
            "additionalItems": true,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name":        { "type": "string", "minLength": 1 },
                    "bio":         { "type": "string" },
                    "affiliation": { "type": "string" },
                    "email":       { "type": "string", "format": "email" },
                    "orcid":       { "type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[0-9X]$" }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "details": {
            "type": "string"
          },
          "abstract": {
            "type": "string"
          },
          "docElement": {
            "type": "string"
          },
          "docId": {
            "type": "string",
            "uniqueItems": true
          },
          "docLabel": {
            "type": "string"
          },
          "docNumber": {
            "type": "string"
          },
          "docPart": {
            "type": "string"
          },
          "volume": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "pages": {
            "type": "string"
          },
          "chapter": {
            "type": "string"
          },
          "edition": {
            "type": "string"
          },
          "docSuiteTitle": {
            "type": "string"
          },
          "docTitle": {
            "type": "string"
          },
          "docType": {
            "type": "string",
            "enum": [
              "Best Practice",
              "Book",
              "Conference Paper",
              "Directive",
              "Dissertation",
              "Draft Standard",
              "Experimental",
              "FAQ",
              "Guideline",
              "Informational",
              "Journal Article",
              "Manual",
              "Magazine Article",
              "Memo",
              "Notation",
              "Note",
              "Patent",
              "Procedure",
              "Recommendation",
              "Registry",
              "Report",
              "Specification",
              "Statement",
              "Style Guide",
              "Technical Bulletin",
              "Technical Doc",
              "Technical Journal",
              "Technical Note",
              "Technical Report",
              "Template",
              "Administrative Guideline",
              "Advisory Note",
              "Engineering Guideline",
              "Engineering Report",
              "Operations Manual",
              "Overview Document",
              "Recommended Practice",
              "Registered Disclosure Document",
              "Standard",
              "Study Group Report",
              "Technical Specification",
              "White Paper"
