            "type": "string"
          },
          "productNumber": {
            "type": "string"
          },
          "familyId": {
            "type": "string"
          },
          "approvalDate": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          },
          "depositDate": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          },
          "abbrevTitle": {
            "type": "string"
          },
          "journalTitle": {
            "type": "string"
          },
          "journalAcronym": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "conferenceLocation": {
            "type": "string"
          },
          "conferenceDate": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": { "type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$" },
              "end":   { "type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$" }
            },
            "patternProperties": {
              "^[a-zA-Z0-9]+\\$meta$": {
                "type": "object",
                "properties": {
                  "source":         { "type": "string", "enum": ["parsed","inferred","manual","resolved","unknown"] },
                  "confidence":     { "type": "string", "enum": ["low","medium","high","unknown"] },
                  "note":           { "type": "string" },
                  "updated":        { "type": "string", "format": "date-time" },
                  "originalValue":  {},
                  "sourceUrl":      { "type": "string", "format": "uri" },
                  "overridden":     { "type": "boolean" },
                  "excludeChanges": { "type": "boolean" },
                  "reviewRequired": { "type": "boolean" },
                  "flag":           { "type": "string" },
                  "version":        { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "copyright": {
            "type": "object",
            "additionalProperties": false,
