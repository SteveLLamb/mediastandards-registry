                  "electronic": { "type": "string" }
                },
                "patternProperties": {
                  "^[a-zA-Z0-9]+\\$meta$": {
                    "type": "object",
                    "properties": {
                      "source":         { "type": "string", "enum": ["parsed","inferred","manual","resolved","unknown"] },
                      "confidence":     { "type": "string", "enum": ["low","medium","high","unknown"] },
                      "note":           { "type": "string" },
                      "updated":        { "type": "string", "format": "date-time" },
